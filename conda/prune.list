# Packages removed from the redistributable before packing, by conda-meta file
# list rather than path globbing.  This file is where "what ships" is decided.
#
# One line per conda package NAME (no version).  Lines are matched exactly.
# '#' comments and blank lines ignored.  A '*' suffix globs.
#
# CRITICAL: drop the compilers, keep the compiler RUNTIME.  Removing
# libgcc/libstdcxx/libgfortran here would make validate.sh fail by
# construction -- libstdc++.so.6 and libgcc_s.so.1 must resolve inside the tree.

# --- toolchain ---------------------------------------------------------------
gcc_*
gxx_*
gfortran_*
gcc_impl_*
gxx_impl_*
gfortran_impl_*
binutils
binutils_*
ld_impl_*
sysroot_*
kernel-headers_*
libgcc-devel_*
libstdcxx-devel_*
libgfortran-devel_*
libsanitizer
c-compiler
cxx-compiler
fortran-compiler

# --- build tools -------------------------------------------------------------
cmake
ninja
pkg-config
patchelf
# PETSc's configure needs diff and libMesh's bundled netcdf needs m4;
# nothing in the artifact needs either.
diffutils
m4
# autoreconf, for PKG_SOURCE=git recipes that bootstrap a checkout.  Same
# category as m4 -- a generator, wanted only while building.  libltdl is
# libtool's runtime library and arrives with it; nothing in the stack links it.
autoconf
automake
libtool
libltdl
# perl is not requested directly.  It used to arrive as a git dependency; git
# has since moved to the builder image, and perl now arrives instead as an
# autoconf/automake dependency -- conda-forge builds both against it, which is
# what the 'pl5321' in their build strings means.  Same package, same reason to
# drop it, different sponsor.
#
# It is also the one package whose libraries live in a nested directory
# (lib/perl5/.../CORE/libperl.so) that the $ORIGIN/../lib rpath rule does not
# reach, so keeping it would mean either a permanently unresolved reference or a
# special case in patchelf.sh.
perl

# --- X11: headers only, never linked -----------------------------------------
# contrib/tecplot/tecio includes <X11/Intrinsic.h> in every translation unit
# (its MASTER.h turns -DLINUX into MOTIF), and libMesh's tecio.m4 disables
# Tecplot output outright when that header is missing.  So the env carries the
# X11 headers -- and nothing else about X11: no object in the tree DT_NEEDEDs
# libXt, libX11 or their transitive libraries, because tecio uses the header for
# typedefs and calls nothing.  Same category as cmake and m4 above: wanted while
# building, not afterwards.
#
# Not optional tidiness, either.  xorg-libx11 ships 14 share/X11/locale/*/Compose
# files carrying an absolute path into the build prefix, which relocate's text
# fixup does not rewrite and validate.sh fails on -- measured, and the reason
# this section exists rather than being left for later.
xorg-*
libxcb
pthread-stubs

# --- glibc floor offenders -----------------------------------------------
# Measured on linux-aarch64: of 837 ELF objects in the solved env, exactly TWO
# require a glibc newer than the 2.28 floor -- libsystemd.so.0 and libudev.so.1,
# both needing 2.34.  Nothing in the tree DT_NEEDEDs them and nothing names them
# for dlopen; libibverbs links only libnl.  They arrive purely as declared conda
# dependencies of rdma-core, which mpich's ch4 fabric stack pulls in.
#
# Dropping them takes the artifact's effective floor from 2.34 back to 2.28 --
# which is the difference between running on almalinux:8 and openSUSE Leap 15
# or not.  Cheapest two lines in this file.  v0 reached the same conclusion the
# hard way, via mpich's --with-hwloc-prefix=embedded --disable-libudev.
libsystemd0
libudev1

# --- python stack: removed only when SHIP_PYTHON=no (see relocate/prune.sh) ---
#@python-only
python
python_abi
pip
setuptools
wheel
tk
libsqlite
readline
