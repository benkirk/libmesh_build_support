# The base-image matrix. Shared by the local compose loop and the S7 CI
# workflow so the two cannot drift apart.
#
#   BASE_IMAGE=ubuntu:24.04 docker compose run --rm --build build make conda
#   VERIFY_IMAGE=almalinux:8 docker compose run --rm --build verify
#
# NOTE THE --build.  Without it compose happily reuses the image it built last
# time and silently ignores the BASE_IMAGE/VERIFY_IMAGE you just set -- so you
# get a green run against the wrong distro and no indication of it.  The verify
# service prints the distro and glibc version it is actually running on for
# exactly this reason; check that line matches what you asked for.
#
# almalinux:8      glibc 2.28  -- the GLIBC_FLOOR=2.28 reference target
# almalinux:9      glibc 2.34
# opensuse/leap:15 glibc 2.31
# ubuntu:22.04     glibc 2.35
# ubuntu:24.04     glibc 2.39
BASES="almalinux:8 almalinux:9 opensuse/leap:15 ubuntu:22.04 ubuntu:24.04"

# Verified so far (linux-aarch64, openblas, mpich, hdf5 serial):
#   built on almalinux:9   -> runs on almalinux:8 (glibc 2.28, the floor)
#                          -> runs on ubuntu:24.04 (glibc 2.39)
# almalinux:8 is the one that matters: before libsystemd0/libudev1 were pruned
# the tree required glibc 2.34 and could not have run there at all.
